// Test file: Enum declarations
import "std-types"

namespace test::enums {
    use std::lib

    // Enum with auto-increment (no explicit values)
    enum DriverType : Int4 {
        UNKNOWN
        HARDWARE
        REFERENCE
        NULL
        SOFTWARE
        WARP
    }

    // Enum with hex values
    enum FeatureLevel : Unt4 {
        LEVEL_9_1  = 0x9100
        LEVEL_9_2  = 0x9200
        LEVEL_9_3  = 0x9300
        LEVEL_10_0 = 0xa000
        LEVEL_10_1 = 0xa100
        LEVEL_11_0 = 0xb000
        LEVEL_11_1 = 0xb100
        LEVEL_12_0 = 0xc000
        LEVEL_12_1 = 0xc100
        LEVEL_12_2 = 0xc200
    }
}
