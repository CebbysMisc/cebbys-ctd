{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "install",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "scripts/install.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "showReuseMessage": false,
                "revealProblems": "onProblem",
                "reveal": "never",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "test",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "-v",
                "-s"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "generate sources",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-Command",
                "New-Item -ItemType Directory -Force -Path sources/lv/cebbys/languages/ctd/antlr4/__generated__ | Out-Null; uv run antlr4 -Dlanguage=Python3 -visitor resources/grammar/Ctd.g4 -o sources/lv/cebbys/languages/ctd/antlr4/__generated__; uv run python scripts/enrich/enrich_parser_with_type_decorators.py sources/lv/cebbys/languages/ctd/antlr4/__generated__/CtdParser.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
