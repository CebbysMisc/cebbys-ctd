import "std-types"

namespace com::microsoft::direct::graphics::dxgi {
    use std::lib

    @CType("DXGI_SAMPLE_DESC")
    flag Usage : Unt4 {
        SHADER_INPUT         = 0x10
        RENDER_TARGET_OUTPUT
        BACK_BUFFER
        SHARED
        READ_ONLY
        DISCARD_ON_PRESENT
        UNORDERED_ACCESS
    }

    @CType("DXGI_SAMPLE_DESC")
    flag SwapChainFlag : Unt4 {
        NON_PRE_RENDERED
        ALLOW_MODE_SWITCH
        GDI_COMPATIBLE
        RESTRICTED_CONTENT
        RESTRICT_SHARED_RESOURCE_DRIVER
        DISPLAY_ONLY
        UNORDERED_ACCESS_VIEW
        FRAME_LATENCY_WAITABLE_OBJECT
        FOREGROUND_LAYER
        FULLSCREEN_VIDEO
        YUV_VIDEO
        HW_PROTECTED
        ALLOW_TEARING
        RESTRICTED_TO_ALL_HOLOGRAPHIC_DISPLAYS
    }

    enum ModeScanLineOrder : Unt4 {
        UNSPECIFIED       = 0
        PROGRESSIVE       = 1
        UPPER_FIELD_FIRST = 2
        LOWER_FIELD_FIRST = 3
    }

    enum ModeScaling : Unt4 {
        UNSPECIFIED = 0
        CENTERED    = 1
        STRETCHED   = 2
    }

    enum Format : Unt4 {
        UNKNOWN             = 0
        R32G32B32A32_FLOAT  = 2
        R32G32B32A32_UINT   = 3
        R32G32B32A32_SINT   = 4
        R16G16B16A16_FLOAT  = 10
        R16G16B16A16_UNORM  = 11
        R32G32_FLOAT        = 16
        R10G10B10A2_UNORM   = 24
        R8G8B8A8_UNORM      = 28
        R8G8B8A8_UNORM_SRGB = 29
        R8G8B8A8_UINT       = 30
        B8G8R8A8_UNORM      = 87
        B8G8R8A8_UNORM_SRGB = 91
    }
    
    @CType("DXGI_SWAP_EFFECT")
    enum SwapEffect : Unt4 {
        DISCARD         = 0
        SEQUENTIAL      = 1
        FLIP_SEQUENTIAL = 3
        FLIP_DISCARD    = 4
    }

    @CType("DXGI_RATIONAL")
    structure Rational {
        Unt4 numerator
        Unt4 denominator
    }

    @CType("DXGI_SAMPLE_DESC")
    structure SampleDesc {
        Unt4 count
        Unt4 quality
    }

    @CType("DXGI_MODE_DESC")
    structure ModeDesc {
        Unt4                width
        Unt4                height
        Rational            refreshRate
        Format              format
        ModeScanLineOrder   scanLineOrdering
        ModeScaling         scaling
    }

    @CType("DXGI_SWAP_CHAIN_DESC")
    structure SwapChainDesc {
        ModeDesc        bufferDesc
        SampleDesc      sampleDesc
        Usage           bufferUsage
        Unt4            bufferCount
        Unt4            outputWindow
        Unt4            windowed
        SwapEffect      swapEffect
        SwapChainFlag   flags
    }

    structure Adapter {
        Any vtable
    }
}