{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "(all) test",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "cebbys-ctd-antlr4/tests",
                "cebbys-ctd-types/tests",
                "cebbys-ctd-meta/tests",
                "cebbys-ctd-resolver/tests",
                "cebbys-ctd-loader/tests",
                "-v"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "lsp: compile typescript",
            "type": "shell",
            "command": "npm",
            "args": ["run", "compile"],
            "options": {
                "cwd": "${workspaceFolder}/cebbys-ctd-lsp/vscode"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "lsp: watch typescript",
            "type": "shell",
            "command": "npm",
            "args": ["run", "watch"],
            "options": {
                "cwd": "${workspaceFolder}/cebbys-ctd-lsp/vscode"
            },
            "isBackground": true,
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": ["$tsc-watch"]
        }
    ]
}