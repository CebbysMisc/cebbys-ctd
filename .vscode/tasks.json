            "label": "(antlr4) install",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "scripts/install.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cebbys-ctd-antlr4"
            },
            "group": "build",
            "presentation": {
                "showReuseMessage": false,
                "revealProblems": "onProblem",
                "reveal": "never",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
