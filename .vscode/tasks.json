{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "-v",
                "-s"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Generate ANTLR4 Sources",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/antlr4.exe",
            "args": [
                "-Dlanguage=Python3",
                "-visitor",
                "resources/grammar/Gtd.g4",
                "-o",
                "sources/lv/cebbys/languages/ctd/antlr4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
