{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "(all) test",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "cebbys-ctd-antlr4/tests",
                "cebbys-ctd-types/tests",
                "cebbys-ctd-meta/tests",
                "cebbys-ctd-resolver/tests",
                "cebbys-ctd-loader/tests",
                "-v"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}