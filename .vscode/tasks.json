        {
            "label": "Generate ANTLR4 Sources",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-Command",
                "New-Item -ItemType Directory -Force -Path sources/lv/cebbys/languages/ctd/antlr4/__generated__ | Out-Null; uv run antlr4 -Dlanguage=Python3 -visitor resources/grammar/Ctd.g4 -o sources/lv/cebbys/languages/ctd/antlr4/__generated__"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cebbys-ctd-antlr4"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        },
