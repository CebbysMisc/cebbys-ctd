{
    "python.analysis.extraPaths": [
        "${workspaceFolder}/cebbys-ctd-antlr4/sources",
        "${workspaceFolder}/cebbys-ctd-types/sources",
        "${workspaceFolder}/cebbys-ctd-meta/sources",
        "${workspaceFolder}/cebbys-ctd-resolver/sources",
        "${workspaceFolder}/cebbys-ctd-loader/sources"
    ],
    "python.analysis.ignore": [
        "**/lv/cebbys/languages/ctd/antlr4/**",
        "**/lv/cebbys/languages/ctd/meta/visitor.py"
    ],
    // "python.analysis.stubPath": "hints",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.cwd": "${workspaceFolder}",
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/cebbys-ctd-antlr4/sources",
        "${workspaceFolder}/cebbys-ctd-types/sources",
        "${workspaceFolder}/cebbys-ctd-meta/sources",
        "${workspaceFolder}/cebbys-ctd-resolver/sources",
        "${workspaceFolder}/cebbys-ctd-loader/sources",
        "${workspaceFolder}/hints"
    ],
    "files.associations": {
        "*.md": "markdown",
        "*.g4": "antlr"
    },
    "antlr4.generation": {
        "mode": "external",
        "language": "Python3",
        "outputDir": "../../sources/lv/cebbys/languages/ctd/antlr4/__generated__",
        "visitors": true,
        "listeners": false
    },
    "antlr4.format": {
        "alignTrailingComments": true,
        "allowShortBlocksOnASingleLine": true,
        "breakBeforeBraces": false,
        "columnLimit": 100,
        "continuationIndentWidth": 4,
        "indentWidth": 4,
        "keepEmptyLinesAtTheStartOfBlocks": false,
        "maxEmptyLinesToKeep": 1,
        "reflowComments": true,
        "spaceBeforeAssignmentOperators": true,
        "useTab": false
    },
    "[antlr]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "mike-lischke.vscode-antlr4"
    },
    "vsicons.associations.folders": [
        {
            "icon": "python",
            "extensions": [
                "hints"
            ],
            "format": "svg"
        },
        {
            "icon": "asset",
            "extensions": [
                "resources"
            ],
            "format": "svg"
        },
        {
            "icon": "module",
            "extensions": [
                "cebbys-ctd-antlr4",
                "cebbys-ctd-loader",
                "cebbys-ctd-meta",
                "cebbys-ctd-resolver",
                "cebbys-ctd-types"
            ],
            "format": "svg"
        }
    ],
    "cSpell.words": [
        "antlr",
        "DXGI",
        "vtable",
        "WAITABLE"
    ],
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": ".*",
                "cmd": "find . -name \"tmpclaude-*-cwd\" -type f -delete 2>/dev/null || del /s /q tmpclaude-*-cwd 2>nul",
                "isAsync": true,
                "silent": true
            }
        ]
    }
}